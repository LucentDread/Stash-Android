<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is always dark: dark themes whatever the system's mode
         (the light ones showed a white screen at launch). -->

    <!-- While the process starts: the app's background and its logo.
         Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI, while it initializes and while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
